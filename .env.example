# Souk Lens — copy to .env (local) or set in your host's Environment Variables (production)

# ---- AI pipeline (any OpenAI-compatible provider) --------------------------
# Without MODEL_API_KEY the app runs the same pipeline in honest Demo mode.
MODEL_API_KEY=
MODEL_BASE_URL=
SEGMENT_MODEL=souk-segment-1
LISTING_MODEL=souk-listing-1
IMAGE_MODEL=souk-image-1
VOICE_MODEL=souk-voice-1

# ---- PayPal Orders API (sandbox by default) --------------------------------
# HACKATHON DEMO → use SANDBOX credentials (matches the default base URL):
#   developer.paypal.com → Apps & Credentials → Sandbox → Create App
#   → copy Client ID + Secret below. Nothing ships, judges test free.
# PRODUCTION (real money) → use LIVE credentials AND set:
#   PAYPAL_API_BASE=https://api-m.paypal.com
# Mismatching live creds with the sandbox base (or vice versa) fails auth.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PayPal settles a fixed currency set (no EGP) — unsupported cart currencies
# convert to this currency at the labeled fixed rate below (shown in the UI).
PAYPAL_CURRENCY=USD
PAYPAL_FX_RATE=50
